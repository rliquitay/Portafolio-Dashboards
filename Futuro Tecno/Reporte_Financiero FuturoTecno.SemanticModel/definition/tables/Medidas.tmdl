	measure 'KPI Fecha Fin' =
			// Última fecha con datos dentro del período seleccionado
			// (ignora País/Marca/Cliente para que todas las tarjetas usen el mismo corte)
			CALCULATE (
			    MAX ( FuturoTecno_2020_2022[Fecha] ),
			    REMOVEFILTERS ( FuturoTecno_2020_2022 )
			)
		formatString: d/m/yyyy
		displayFolder: KPI HTML\Base
		lineageTag: 73bdff23-c832-4ccf-afff-41767e4d1557

	measure 'Ingresos AA' =
			VAR _Ini = MIN ( Calendario[Date] )
			VAR _Fin = [KPI Fecha Fin]
			RETURN
			    CALCULATE (
			        [01. Total Ingresos],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Date] >= EDATE ( _Ini, -12 )
			            && Calendario[Date] <= EDATE ( _Fin, -12 )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: KPI HTML\Base
		lineageTag: cf881264-f113-425e-8de9-43eff5a91fdb

	measure 'Ingresos Último Mes' =
			VAR _Fin = [KPI Fecha Fin]
			RETURN
			    CALCULATE (
			        [01. Total Ingresos],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Date] > EOMONTH ( _Fin, -1 )
			            && Calendario[Date] <= EOMONTH ( _Fin, 0 )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: KPI HTML\Base
		lineageTag: 551cde77-9313-40f4-9502-b741d927a24e

	measure 'Ingresos Mes Anterior' =
			VAR _Fin = [KPI Fecha Fin]
			RETURN
			    CALCULATE (
			        [01. Total Ingresos],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Date] > EOMONTH ( _Fin, -2 )
			            && Calendario[Date] <= EOMONTH ( _Fin, -1 )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: KPI HTML\Base
		lineageTag: 34402723-a3ef-4bc0-83b5-e2a297a41653

	measure 'Ingresos % Var AA' = DIVIDE ( [01. Total Ingresos] - [Ingresos AA], ABS ( [Ingresos AA] ) )
		formatString: 0.0%;-0.0%;0.0%
