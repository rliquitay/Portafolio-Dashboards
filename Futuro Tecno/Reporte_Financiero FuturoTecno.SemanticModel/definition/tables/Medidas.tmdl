	measure '07. % MoM Ingresos' =
			VAR __v = [Ingresos % Var Mes]
			RETURN
			    IF (
			        ISBLANK ( __v ),
			        BLANK (),
			        FORMAT ( __v, "+0.0%;-0.0%;0.0%" ) & " " & IF ( __v * 1 >= 0, UNICHAR ( 129137 ), UNICHAR ( 129139 ) )
			    )
		lineageTag: 7e6c95c3-c131-443b-835b-410bb20babdb

	measure '07. Color MoM Ingresos' =
